# Example settings file. This one is safe to share: it holds a placeholder, not a real key.
# To use it: copy this file, name the copy .env, and replace the placeholder with your own key.
# Get a free key at https://www.eia.gov/opendata/register.php
# .env is listed in .gitignore, so your real key never gets uploaded to GitHub.
EIA_API_KEY=your_eia_api_key_here
